# Google Maps JS API key (frontend). Must live in frontend/my-app/.env to be
# picked up by react-scripts; CRA only exposes REACT_APP_* variables.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional DataSF / Socrata app token. Without one the citation fetch still
# works but is rate limited. https://data.sf.gov/profile/edit/developer_settings
SODA_APP_TOKEN=

# Citation window and search radius around campus (defaults: 90 days, 1500 m)
CITATION_DAYS=90
CITATION_RADIUS_M=1500
